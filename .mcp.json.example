{
  "mcpServers": {
    "claude-activity-memory": {
      "command": "node",
      "args": ["dist/index.js"],
      "cwd": "/absolute/path/to/claude-activity-memory",
      "env": {
        "DATABASE_URL": "postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
      }
    }
  }
}

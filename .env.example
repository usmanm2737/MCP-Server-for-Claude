# --- Database (required — a Postgres connection string, e.g. from Supabase) ---
# Project Settings -> Database -> Connection string -> "URI" in the Supabase dashboard.
# There is no local-file fallback; the server refuses to start without this.
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# How strictly to verify the database's TLS certificate chain:
#   require (default) — encrypted, but doesn't verify the cert chain (standard for Supabase)
#   strict             — encrypted and verifies against Node's CA bundle
#   disable            — no TLS at all (only for a local Postgres with no TLS configured)
# CLAUDE_MEMORY_DB_SSL=require

# Maximum rows a single search/list tool call may return.
# CLAUDE_MEMORY_MAX_RESULTS=50

# Maximum accepted size (bytes) for an imported conversation file.
# CLAUDE_MEMORY_MAX_IMPORT_BYTES=5000000

# Maximum number of messages/records a single import_conversation call may create.
# CLAUDE_MEMORY_MAX_IMPORT_RECORDS=2000

# Comma-separated absolute directories that import_conversation's filePath
# must resolve inside. Empty (default) = no restriction beyond the path the
# MCP caller explicitly provided (there is no filesystem-scanning tool, so
# the caller choosing a path IS the "user selection").
# CLAUDE_MEMORY_IMPORT_DIRS=

# --- Optional Express ingestion API (disabled unless explicitly enabled) ---

# Set to "true" to allow `npm run start:http` to actually bind a port.
# CLAUDE_MEMORY_HTTP_ENABLED=false

# Host/port the optional HTTP API binds to. Defaults to localhost-only.
# CLAUDE_MEMORY_HTTP_HOST=127.0.0.1
# CLAUDE_MEMORY_HTTP_PORT=8787

# Required bearer token for write endpoints on the optional HTTP API.
# Generate one yourself, e.g.: node -e "console.log(require('crypto').randomUUID())"
# There is no default — the server refuses to start with HTTP enabled and no token set.
# CLAUDE_MEMORY_HTTP_TOKEN=

# Comma-separated list of allowed CORS origins for the HTTP API. Empty = no
# cross-origin browser access (same-origin/non-browser clients only).
# CLAUDE_MEMORY_HTTP_CORS_ORIGINS=

# --- Optional remote MCP server over HTTP (disabled unless explicitly enabled) ---
# For connecting a remote MCP client (e.g. claude.ai web's custom connectors) —
# multiple Claude profiles/sessions can connect to this at once, sharing the
# same memory in the DATABASE_URL above. Used for local testing via a tunnel
# (ngrok) and for a real deployment (e.g. Render). See README "Testing with
# claude.ai web via a tunnel" and "Deploying to Render".

# Set to "true" to allow `npm run start:remote-mcp` to actually bind a port.
# CLAUDE_MEMORY_REMOTE_MCP_ENABLED=false

# Host/port it binds to.
#   - Local + ngrok: leave as 127.0.0.1 — ngrok forwards from its public URL to
#     this local port, so the server itself never needs a non-loopback address.
#   - Render (or most PaaS platforms): auto-detected and defaulted to 0.0.0.0
#     when `PORT` or `RENDER` is present in the environment — you shouldn't need
#     to set either of these at all on Render.
# CLAUDE_MEMORY_REMOTE_MCP_HOST=127.0.0.1
# CLAUDE_MEMORY_REMOTE_MCP_PORT=8789

# Required bearer token. Generate one yourself, e.g.:
#   node -e "console.log(require('crypto').randomUUID())"
# There is no default — the server refuses to start enabled with no token set.
# Every connected profile/session uses this same token (shared-memory model —
# see README "Multiple Claude profiles at once").
# CLAUDE_MEMORY_REMOTE_MCP_TOKEN=

# Comma-separated hostnames (no scheme, no port) allowed in a request's Host
# header — required DNS-rebinding protection. You MUST add your tunnel's or
# deployment's hostname here (e.g. "abcd1234.ngrok-free.app" or
# "claude-activity-memory.onrender.com") or every request gets rejected with
# 403; add "localhost,127.0.0.1" too if you still want to test locally.
# CLAUDE_MEMORY_REMOTE_MCP_ALLOWED_HOSTS=

# Comma-separated hostnames allowed in a request's Origin header, when one is
# present at all (most non-browser MCP clients send no Origin header, in which
# case this list is never consulted). Usually leave unset.
# CLAUDE_MEMORY_REMOTE_MCP_ALLOWED_ORIGINS=
